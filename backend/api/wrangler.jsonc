{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "3ee25fc8fe5e195ebf2e54da536e2d62",
  "name": "hisaab-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hisaab",
      "database_id": "ec0df364-b3f9-4214-975f-7e75c9cba14f",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "staging": {
      "name": "hisaab-api-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hisaab-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../packages/database/migrations",
        },
      ],
    },
    "production": {
      "name": "hisaab-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://hisaab.blobforges.workers.dev",
        "BETTER_AUTH_URL": "https://hisaab-api.blobforges.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hisaab",
          "database_id": "ec0df364-b3f9-4214-975f-7e75c9cba14f",
          "migrations_dir": "../../packages/database/migrations",
        },
      ],
    },
  },
}
