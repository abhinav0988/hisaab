{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "3ee25fc8fe5e195ebf2e54da536e2d62",
  "name": "hisaab-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hisaab",
      "database_id": "ec0df364-b3f9-4214-975f-7e75c9cba14f",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "services": [
    { "binding": "AUTH", "service": "hisaab-auth" },
    { "binding": "PROFILE", "service": "hisaab-profile" },
    { "binding": "ACCOUNTS", "service": "hisaab-accounts" },
    { "binding": "CATEGORIES", "service": "hisaab-categories" },
    { "binding": "TRANSACTIONS", "service": "hisaab-transactions" },
    { "binding": "BUDGETS", "service": "hisaab-budgets" },
    { "binding": "REPORTS", "service": "hisaab-reports" },
    { "binding": "RECURRING", "service": "hisaab-recurring" },
    { "binding": "FINANCE", "service": "hisaab-finance" },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
