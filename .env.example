# Web
NEXT_PUBLIC_API_URL=http://localhost:8787

# Auth Worker: copy to backend/auth/.dev.vars for local development.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
APP_ORIGIN=http://localhost:3000
# Auth email (copy into backend/auth/.dev.vars). Resend is preferred; webhook is a fallback.
RESEND_API_KEY=
EMAIL_FROM=Hisaab <onboarding@resend.dev>
AUTH_DEV_EXPOSE_OTP=true
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Gateway Worker: copy to backend/gateway/.dev.vars (RATE_LIMIT_SECRET is also in wrangler.jsonc for local).
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
