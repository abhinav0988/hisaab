{
  "expo": {
    "name": "Hisaab",
    "slug": "hisaab",
    "scheme": "hisaab",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#021612"
    },
    "ios": {
      "bundleIdentifier": "com.hisaab.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.hisaab.mobile",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01160F"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Hisaab to use your camera to select a receipt.",
          "photosPermission": "Allow Hisaab to access your photos to select a receipt.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
